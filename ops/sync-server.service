# /etc/systemd/system/sync-server.service
# The server listens on loopback only. TLS and public access belong to Caddy or nginx.
[Unit]
Description=Lockstep Sync server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=syncsrv
Group=syncsrv
ExecStart=/usr/local/bin/sync-server serve --data /var/lib/sync-server --addr 127.0.0.1:8080
Restart=always
RestartSec=3

# All state lives on disk, so a restart is safe at any moment.
StateDirectory=sync-server
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/sync-server
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
